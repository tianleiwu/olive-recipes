{
    "input_model": {
        "type": "HfModel",
        "model_path": "Qwen/Qwen3.6-35B-A3B"
    },
    "systems": {
        "local_system": {
            "type": "LocalSystem",
            "accelerators": [
                {
                    "device": "gpu",
                    "execution_providers": ["CUDAExecutionProvider"]
                }
            ]
        }
    },
    "passes": {
        "m": {
            "type": "ModelBuilder",
            "precision": "int4",
            "int4_block_size": 32,
            "int4_algo_config": "default",
            "include_hidden_states": true,
            "exclude_embeds": false,
            "enable_cuda_graph": true,
            "extra_options": {
                "moe_quant_type": "int4",
                "qmoe_block_size": 64,
                "matmul_mixed_precision": "last_matmul:int8,mixed_layers:int8",
                "enable_mtp": true,
                "mtp_head_quant_type": "int8",
                "mtp_emit_hidden": true,
                "filename": "text.onnx"
            }
        }
    },
    "target": "local_system",
    "no_artifacts": true,
    "output_dir": "cuda/models/int4-b64"
}
