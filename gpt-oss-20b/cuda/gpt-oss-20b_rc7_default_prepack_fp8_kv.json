{
  "input_model": {
    "type": "HfModel",
    "model_path": "openai/gpt-oss-20b",
    "load_kwargs": {
      "torch_dtype": "float16"
    }
  },
  "systems": {
    "local_system": {
      "type": "LocalSystem",
      "accelerators": [
        {
          "device": "gpu",
          "execution_providers": [
            "CUDAExecutionProvider"
          ]
        }
      ]
    }
  },
  "passes": {
    "m": {
      "type": "ModelBuilder",
      "precision": "int4",
      "int4_algo_config": "default",
      "int4_op_types_to_quantize": [
        "MatMul"
      ],
      "extra_options": {
        "int4_block_size": 32,
        "qmoe_block_size": 0,
        "disable_qk_norm_fusion": 0,
        "last_matmul_weight_int8": 1,
        "int8_mixed_layers": 1,
        "use_8bits_moe": 0,
        "matmulnbits_weights_prepacked": 1,
        "kv_cache_quant_type": "fp8_per_channel",
        "kv_cache_scale_file": "/home/tianlei/tmp/kv_scales_fp8_per_channel.json"
      }
    }
  },
  "target": "local_system",
  "log_severity_level": 0,
  "output_dir": "model_fp8_kv",
  "cache_dir": "cache",
  "no_artifacts": true
}
